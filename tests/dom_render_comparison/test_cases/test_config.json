{
    "version": "1.0",
    "description": "DOM元素渲染比较测试配置",
    "tolerance": {
        "position": 2,
        "size": 2,
        "color": 5
    },
    "categories": [
        {
            "id": "text",
            "name": "文本元素",
            "elements": ["h1", "h2", "h3", "h4", "h5", "h6", "p", "span", "strong", "em", "code", "pre"]
        },
        {
            "id": "container",
            "name": "容器元素",
            "elements": ["div", "section", "article", "header", "footer", "main", "nav", "aside"]
        },
        {
            "id": "list",
            "name": "列表元素",
            "elements": ["ul", "ol", "li", "dl", "dt", "dd"]
        },
        {
            "id": "table",
            "name": "表格元素",
            "elements": ["table", "thead", "tbody", "tfoot", "tr", "th", "td", "caption"]
        },
        {
            "id": "form",
            "name": "表单元素",
            "elements": ["form", "input", "button", "select", "textarea", "label", "fieldset", "legend"]
        },
        {
            "id": "media",
            "name": "媒体元素",
            "elements": ["img", "video", "audio", "canvas", "svg"]
        },
        {
            "id": "inline",
            "name": "行内元素",
            "elements": ["a", "br", "hr", "small", "sub", "sup", "mark", "abbr"]
        }
    ],
    "css_properties": {
        "layout": [
            "display", "position", "top", "left", "right", "bottom",
            "width", "height", "min-width", "max-width", "min-height", "max-height",
            "margin", "padding", "border-width"
        ],
        "flexbox": [
            "flex-direction", "flex-wrap", "justify-content", "align-items", "align-content",
            "flex-grow", "flex-shrink", "flex-basis", "order", "align-self"
        ],
        "grid": [
            "grid-template-columns", "grid-template-rows", "grid-column", "grid-row",
            "grid-gap", "justify-items", "align-items"
        ],
        "text": [
            "font-family", "font-size", "font-weight", "font-style",
            "text-align", "text-decoration", "line-height", "letter-spacing",
            "color", "text-transform", "white-space", "word-wrap"
        ],
        "visual": [
            "background-color", "background-image", "border-color", "border-style", "border-radius",
            "box-shadow", "opacity", "visibility", "overflow", "z-index"
        ],
        "transform": [
            "transform", "transform-origin"
        ]
    }
}

