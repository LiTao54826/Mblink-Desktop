{
  "build": {
    "builder": "esbuild",
    "external": [
      "preact",
      "preact/hooks"
    ],
    "hide_console": false,
    "icon": "",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "minify": false,
    "sourcemap": true
  },
  "entry": "ui/app.js",
  "name": "python-audio-smoke",
  "out_dir": ".dist",
  "purpose": "minimal",
  "runtime": "python",
  "src_dir": "ui",
  "template": "minimal/python",
  "window": {
    "height": 300,
    "title": "MBink Python Audio Smoke",
    "width": 760
  }
}
