{
  "template": "minimal/go",
  "purpose": "minimal",
  "runtime": "go",
  "entry": "ui/app.js",
  "src_dir": "ui",
  "out_dir": ".dist",
  "window": {
    "title": "MBlink minimal (go)",
    "width": 900,
    "height": 640
  },
  "build": {
    "builder": "esbuild",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "external": ["preact", "preact/hooks"],
    "sourcemap": true,
    "minify": false,
    "hide_console": true,
    "icon": "assets/app.ico"
  }
}
