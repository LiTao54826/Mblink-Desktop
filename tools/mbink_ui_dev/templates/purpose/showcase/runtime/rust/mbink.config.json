{
  "template": "showcase/rust",
  "purpose": "showcase",
  "runtime": "rust",
  "entry": "ui/app.js",
  "src_dir": "ui",
  "out_dir": ".dist",
  "window": {
    "title": "MBink showcase (rust)",
    "width": 1060,
    "height": 760
  },
  "build": {
    "builder": "esbuild",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "external": ["preact", "preact/hooks"],
    "sourcemap": true,
    "minify": false
  }
}
