{
    "template":  "desktop-app/python",
    "purpose":  "desktop-app",
    "runtime":  "python",
    "entry":  "ui/app.js",
    "src_dir":  "ui",
    "out_dir":  ".dist",
    "window":  {
                   "title":  "MBink desktop-app (python)",
                   "width":  1120,
                   "height":  780,
                   "borderless":  true,
                   "resizable":  true
               },
    "build":  {
                  "builder":  "esbuild",
                  "jsx_factory":  "h",
                  "jsx_fragment":  "Fragment",
                  "external":  [
                                   "preact",
                                   "preact/hooks"
                               ],
                  "sourcemap":  true,
                  "minify":  false,
                  "hide_console":  true,
                  "icon":  "assets/app.ico"
              }
}
