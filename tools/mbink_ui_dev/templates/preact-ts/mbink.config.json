{
  "template": "preact-ts",
  "entry": "src/app.js",
  "src_dir": "src",
  "out_dir": ".dist",
  "window": {
    "title": "MBink Preact TS Template",
    "width": 960,
    "height": 720
  },
  "build": {
    "builder": "esbuild",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "external": ["preact", "preact/hooks"],
    "sourcemap": true,
    "minify": false
  }
}
