{
  "template": "python",
  "entry": "ui/app.js",
  "src_dir": "ui",
  "out_dir": ".dist",
  "window": {
    "title": "MBink Python Host Template",
    "width": 980,
    "height": 720
  },
  "build": {
    "builder": "esbuild",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "external": ["preact", "preact/hooks"],
    "sourcemap": true,
    "minify": false
  }
}
