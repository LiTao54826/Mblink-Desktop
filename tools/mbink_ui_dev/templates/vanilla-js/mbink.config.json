{
  "template": "vanilla-js",
  "entry": "src/app.js",
  "src_dir": "src",
  "out_dir": ".dist",
  "window": {
    "title": "MBink Vanilla JS Template",
    "width": 920,
    "height": 680
  },
  "build": {
    "builder": "esbuild",
    "jsx_factory": "h",
    "jsx_fragment": "Fragment",
    "external": ["preact", "preact/hooks"],
    "sourcemap": true,
    "minify": false
  }
}
